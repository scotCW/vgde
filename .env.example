# Copy to .env and fill in real values. Never commit .env.

NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# postgres://<user>:<password>@<host>:5432/<db>
DATABASE_URL=postgresql://voting_game:changeme@localhost:5432/voting_game

# Signs session cookies. Generate with: openssl rand -base64 48
SESSION_SECRET=

# Set to false only for local http:// development without TLS.
COOKIE_SECURE=true

# Comma-separated list of origins allowed to call the API / open the
# websocket, e.g. https://voting.example.com. Leave empty to skip the
# origin allowlist check (still protected by sameSite=strict cookies).
ALLOWED_ORIGINS=

# Optional: enables "log in with <provider>" via any standard OIDC issuer
# (Authentik, Keycloak, Google, etc). An unknown verified-email login
# auto-provisions a new account. Leave unset to disable OIDC entirely.
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:3000/auth/oidc/callback

# "oidc_only" removes /auth/register and /auth/login entirely (404, not a
# soft-hidden form) and hides the local-login form — a hard cutover, not
# per-account. Refuses to start if OIDC isn't fully configured above, so
# this can't lock everyone out. Leave as password_and_oidc until you've
# confirmed OIDC login actually works end to end.
AUTH_MODE=password_and_oidc

# Used by docker-compose to create the Postgres container.
POSTGRES_USER=voting_game
POSTGRES_PASSWORD=changeme
POSTGRES_DB=voting_game
